meta {
  name: List Users
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/admin/users?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
}

auth:bearer {
  token: {{access_token}}
}

vars:pre-request {
  base_url: http://localhost:8080
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("should return users array", function() {
    expect(res.body.data).to.be.an('array');
  });
  
  test("should include pagination", function() {
    expect(res.body.pagination).to.be.an('object');
    expect(res.body.pagination.page).to.equal(1);
    expect(res.body.pagination.limit).to.equal(10);
  });
}

docs {
  # List Users (Admin Only)
  
  Retrieve a paginated list of all users.
  
  **Query Parameters:**
  - `page`: Page number (default: 1)
  - `limit`: Items per page (default: 10, max: 100)
  
  **Required Role:** admin
}
