meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "john.doe@example.com",
    "username": "johndoe",
    "password": "SecurePass123",
    "full_name": "John Doe"
  }
}

vars:pre-request {
  base_url: http://localhost:8080
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("access_token", res.body.data.access_token);
    bru.setVar("refresh_token", res.body.data.refresh_token);
  }
}

tests {
  test("should return 201", function() {
    expect(res.status).to.equal(201);
  });
  
  test("should return access token", function() {
    expect(res.body.data.access_token).to.be.a('string');
  });
  
  test("should return user data", function() {
    expect(res.body.data.user).to.be.an('object');
    expect(res.body.data.user.email).to.equal('john.doe@example.com');
  });
}
